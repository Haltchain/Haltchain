{
  "name": "@haltchain/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the HaltChain validator — browser + Node.js 18+",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./langgraph": {
      "import": "./dist/langgraph.js",
      "types": "./dist/langgraph.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test test/checkpoint.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
